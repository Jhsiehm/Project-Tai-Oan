{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taiwan Opera Map record",
  "type": "object",
  "required": ["id", "act", "kind", "names", "start_year", "certainty", "confidence", "status", "card", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "act": { "enum": ["prologue", "I", "II", "III", "IV", "V", "VI", "epilogue"] },
    "kind": { "enum": ["infrastructure", "governance", "people", "event", "fact", "myth-vs-fact"] },
    "names": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string" },
        "zh": { "type": "string" },
        "indigenous": { "type": "string", "description": "Endonym; omit unless confirmed" }
      }
    },
    "start_year": { "type": "integer" },
    "end_year": { "type": ["integer", "null"] },
    "date_note": { "type": "string" },
    "geometry": {
      "type": ["object", "null"],
      "description": "GeoJSON Point/LineString/Polygon; null if not yet mapped",
      "properties": { "type": { "enum": ["Point", "LineString", "Polygon", "MultiPolygon"] }, "coordinates": {} }
    },
    "certainty": { "enum": ["documented", "estimated", "disputed"] },
    "confidence": { "enum": ["verified", "partly-verified", "unverified"] },
    "status": { "enum": ["draft", "reviewed", "published"] },
    "card": {
      "type": "object",
      "required": ["en"],
      "properties": { "en": { "type": "string" }, "zh": { "type": "string" }, "myth": { "type": "string" }, "fact": { "type": "string" } }
    },
    "indigenous_thread": { "type": "string" },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Keys into sources.seed.json" },
    "notes": { "type": "string" },
    "reviewer": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
